# Public Cloudflare site key. Never put the secret key in a VITE_ variable.
# Optional: leave empty when Turnstile is not configured in the backend. The built-in numerical challenge remains enabled.
VITE_TURNSTILE_SITE_KEY=
# Public origin in Coolify: https://uypolls.online (browser API calls stay on /api).
# Backend public domain: https://mapi.uypolls.online; administration lives there.
# Coolify runtime: private DNS name of the backend on the shared Docker network.
# Replace PENDIENTE_BACKEND; never use localhost or a public API domain here.
BACKEND_UPSTREAM=http://PENDIENTE_BACKEND:5000
# Exact IPv4/IPv6 CIDR of the Coolify proxy. Do not use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDR=PENDIENTE_RED_PROXY
# Local Vite uses http://127.0.0.1:5000 by default without this file.
